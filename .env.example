# Public site URL for Open Graph / metadata
NEXT_PUBLIC_SITE_URL=https://miterbox.com

# ─────────────────────────────────────────────────────────────
# Contact delivery (required for /api/contact → Zapier)
# Copy this file to `.env.local` and fill in real values.
# Never commit `.env.local`.
# ─────────────────────────────────────────────────────────────

# Zapier Catch Hook URL — receives JSON:
# { name, email, phone, projectType, location, message }
ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/xxxxxxxx/xxxxxxxx/
