# Public site URL for Open Graph / metadata
NEXT_PUBLIC_SITE_URL=https://miterbox.com

# ─────────────────────────────────────────────────────────────
# Contact delivery (required for email + SMS from /api/contact)
# Copy this file to `.env.local` and fill in real values.
# Never commit `.env.local`.
# ─────────────────────────────────────────────────────────────

# Resend — https://resend.com
# Create an API key, then set a from-address.
# Until you verify miterbox.com, you can use: MITERBOX <onboarding@resend.dev>
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=MITERBOX <onboarding@resend.dev>

# Inbox that receives inquiries
CONTACT_TO_EMAIL=miterbox@gmail.com

# Twilio — https://console.twilio.com
# Account SID + Auth Token from the Twilio dashboard
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Twilio phone number that SENDS the SMS (E.164 format, e.g. +12085551234)
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Phil’s mobile number that RECEIVES the SMS (E.164 format)
PHIL_PHONE_NUMBER=+1XXXXXXXXXX
